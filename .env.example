# Application Settings
APP_NAME="AI Learning Tutor Chatbot"
APP_ENV="development"
DEBUG=True
PORT=8000
HOST="0.0.0.0"

# Security & Authentication
# JWT Secret Key (실제 배포 시 임의의 강력한 문자열로 변경하세요: openssl rand -hex 32)
SECRET_KEY="feelosophysics-chatbot-super-secret-key-change-in-production"
ALGORITHM="HS256"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Settings (SQLite)
DATABASE_URL="sqlite:///./chatbot.db"

# AI Model Settings (Google Gemini / Gemma 4 API)
# API 키를 발급받아 입력하세요 (https://aistudio.google.com/)
# 미설정 시 자동으로 Smart Demo/Mock 모드가 동작합니다.
GEMINI_API_KEY=""
GEMINI_MODEL_NAME="gemma-4-26b-a4b-it"  # AI Studio Gemma 4 26B (또는 gemma-4-31b-it)
AI_TIMEOUT_SECONDS=30
MAX_HISTORY_MESSAGES=10
